/**
 * @see https://github.com/DavidAnson/markdownlint-cli2
 * Note: All rules are enabled by default.
 */
{
	"globs": ["**/*.md"],
	"gitignore": true,
	"ignores": ["LICENCE*", "LICENSE*"],
	"config": {
		// Disables all markdownlint rules that overlap with Prettier.
		// Ref: https://github.com/DavidAnson/markdownlint/blob/main/doc/Prettier.md
		"extends": "markdownlint/style/prettier",

		// Rationale: https://google.github.io/styleguide/docguide/style.html#codeblocks
		"code-block-style": {
			"style": "fenced"
		},

		// Rationale:
		// - https://google.github.io/styleguide/docguide/style.html#atx-style-headings
		// - https://cirosantilli.com/markdown-style-guide/#option-header-atx
		"heading-style": {
			"style": "atx"
		},

		// Rationale: See example in https://github.com/DavidAnson/markdownlint/blob/main/doc/md024.md
		"no-duplicate-heading": {
			"siblings_only": true
		},

		// Rationale: Personal preference.
		"no-inline-html": false,

		// Rationale: Re-enables rule (disabled by Prettier preset) to fix '#Heading' -> '# Heading'.
		"no-missing-space-atx": true,

		// Rationale: Re-enables rule (disabled by Prettier preset) to fix '#Heading#' -> '# Heading #'.
		"no-missing-space-closed-atx": true,

		// Rationale: Space inside code spans can be intentional when documenting literal space characters as part of syntax notation (e.g. ` :`).
		"no-space-in-code": false,

		// Rationale: Allows '!' (default is ".,;:!。，；：！").
		"no-trailing-punctuation": {
			"punctuation": ".,;:。，；：！"
		}
	}
}
